# Parameterized image for every workspace frontend app (host + remotes).
# Build from the frontend/ workspace root:
#   docker build -f docker/Dockerfile.mfe --build-arg APP=<package-name> .
FROM node:22-alpine AS build
ARG APP
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /workspace
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm --filter ${APP} build

FROM nginx:1.27-alpine
ARG APP
ARG NGINX_CONF=nginx.remote.conf
COPY docker/${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/${APP}/dist /usr/share/nginx/html
